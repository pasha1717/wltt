# Bu dosyayı .env adıyla kopyala ve değerleri yalnız .env içine yaz.
# .env git'e girmez. Değerleri sohbete yapıştırma.

# Ses üretimi (tek seferlik, araclar/ses-uret.js)
ELEVENLABS_API_KEY=
ELEVEN_SES_ID=
ELEVEN_MODEL=eleven_v3

# 1 = yalnız hazır sesler ve balon, hiçbir dış servise gidilmez
TEST_MODU=1

# OBS > Araçlar > WebSocket Sunucu Ayarları
OBS_SIFRE=

# TikTok kullanıcı adı (@ olmadan). Yalnız okuma yapılır.
TIKTOK_KULLANICI=

BEGENI_HEDEFLERI=5,10,20,30
SESSIZLIK_SN=40
PORT=3900
